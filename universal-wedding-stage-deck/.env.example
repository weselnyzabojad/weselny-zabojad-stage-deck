# Copy to .env.local (never commit real project keys).
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Deck mode: "local" (default) uses the 4-digit DDMM display PIN and the
# `wzsd:<weddingId>` room key. "production" requires the server-validated
# per-role PIN flow (`join_room` Edge Function + role token).
# VITE_DECK_MODE=local

# Optional overrides
# VITE_SUPABASE_SYNC_TABLE=live_sync_state
# VITE_SUPABASE_ROOM_PREFIX=wzsd

# When either required variable above is missing the app runs in local-only mode
# (localStorage + cross-tab storage events) and the sync badge shows
# "Local only". No cloud calls are attempted.
#
# Edge Function secrets (server-side only, set with `supabase secrets set`):
#   SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET,
#   PUBLIC_DECK_URL, ALLOWED_ORIGIN
#
# Owner admin panel: `/deck/admin` uses Supabase Auth + TOTP MFA. Apply
# `supabase/migrations/202611060001_owner_admin.sql` and
# `202611060003_cartridge_revisions.sql`, deploy `admin_api`, then
# add the owner to `public.app_admins` (there is no self-signup). `PUBLIC_DECK_URL`
# is the base used for QR role links, e.g. https://www.weselnyzabojad.pl/deck
