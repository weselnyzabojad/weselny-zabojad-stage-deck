# Copy to .env.local (never commit real project keys).
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional overrides
# VITE_SUPABASE_SYNC_TABLE=live_sync_state
# VITE_SUPABASE_ROOM_PREFIX=wzsd

# When either variable above is missing the app runs in local-only mode
# (localStorage + cross-tab storage events) and the sync badge shows
# "Local only". No cloud calls are attempted.
