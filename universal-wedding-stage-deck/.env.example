# Copy to .env.local (never commit real project keys).
# Supabase Dashboard -> Project Settings -> API
#
# Validate this file with: npm run validate:env
# Full setup guide: docs/admin-setup-and-secrets.md

# --- Required browser-safe client variables -------------------------------
# The anon/publishable key is public by design; database access is still
# protected by RLS. Never put the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional client variables --------------------------------------------
# Deck mode: "local" (default) uses the 4-digit DDMM display PIN and the
# `wzsd:<weddingId>` room key. "production" requires the server-validated
# per-role PIN flow (`join_room` Edge Function + role token).
# VITE_DECK_MODE=local

# Optional overrides
# VITE_SUPABASE_SYNC_TABLE=live_sync_state
# VITE_SUPABASE_ROOM_PREFIX=wzsd

# Development-only helpers. Leave unset in production builds.
# VITE_ADMIN_DEMO=1
# VITE_VIEW=mc

# When either required variable above is missing the app runs in local-only mode
# (localStorage + cross-tab storage events) and the sync badge shows
# "Local only". No cloud calls are attempted. The admin panel requires both.

# --- Server-side Edge Function secrets (never use VITE_*) ------------------
# Set these with `supabase secrets set NAME=value`; they must not appear in
# .env.local, in committed files or behind a VITE_* variable.
#
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_JWT_SECRET
#   PUBLIC_DECK_URL
#   ALLOWED_ORIGIN
#   GOOGLE_SERVICE_ACCOUNT_EMAIL
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY
#   GOOGLE_DRIVE_TEST_FILE_ID (optional)
#
# `PUBLIC_DECK_URL` is the base used for QR role links,
# e.g. https://www.weselnyzabojad.pl/deck
# `ALLOWED_ORIGIN` must match the page origin, e.g.
# http://localhost:5173 locally and the deployed origin in production.

# --- Owner admin panel (`/admin`) -----------------------------------------
# Uses Supabase Auth email/password + TOTP MFA and the `public.app_admins`
# allowlist. There is no self-signup.
#
# Apply `supabase/migrations/202611060001_owner_admin.sql`,
# `202611060003_cartridge_revisions.sql` and
# `202611060004_drive_publication.sql`, deploy `admin_api` and `admin_drive`,
# then add the owner to `public.app_admins`. The legacy `/deck/admin` path
# redirects to `/admin`; admin access is laptop/desktop-only.
