{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/speed-foto.json",
  "title": "Speed photo game domain",
  "description": "Speed-photo game. It is a timeline game step; the photo plan references it by Step ID.",
  "type": "object",
  "properties": {
    "speedFoto": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "stepId": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "durationMin": {
          "type": "integer",
          "minimum": 0
        },
        "music": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "speedFoto"
  ]
}
