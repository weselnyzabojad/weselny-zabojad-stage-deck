{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/steps.json",
  "title": "Timeline steps domain",
  "description": "Plan-of-the-day timeline mapped from the Google Doc. Each step is a FLEXIBLE or HARD_ANCHOR block.",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "required": [
    "steps"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "clock": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "24-hour local clock time as HH:MM."
    },
    "language": {
      "type": "string",
      "enum": [
        "PL",
        "FR",
        "EN"
      ]
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "PL": {
          "type": "string"
        },
        "FR": {
          "type": "string"
        },
        "EN": {
          "type": "string"
        }
      }
    },
    "djCue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "playlist": {
          "type": "string"
        },
        "track": {
          "type": "string"
        },
        "cutoff": {
          "$ref": "#/$defs/clock"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "speechItem": {
      "type": "object",
      "required": [
        "id",
        "heading",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "heading": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "lang",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "lang": {
                "$ref": "#/$defs/language"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "gameQuestion": {
      "type": "object",
      "required": [
        "id",
        "question",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "$ref": "#/$defs/localizedText"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "teleprompter": {
      "type": "object",
      "required": [
        "has_script",
        "type",
        "title",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "has_script": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "SPEECH",
            "GAME_QUESTIONS"
          ]
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "SPEECH"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/speechItem"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "GAME_QUESTIONS"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/gameQuestion"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "items": {
                "minItems": 1
              }
            },
            "required": [
              "items"
            ]
          },
          "then": {
            "properties": {
              "has_script": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "time",
        "durationMin",
        "title",
        "type",
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "time": {
          "$ref": "#/$defs/clock",
          "description": "Planned start time."
        },
        "planned": {
          "$ref": "#/$defs/clock",
          "description": "Optional explicit planned start; overrides time for drift math."
        },
        "realStart": {
          "$ref": "#/$defs/clock",
          "description": "Optional seeded actual start, mainly for demos/tests."
        },
        "durationMin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 720,
          "description": "Zero-duration steps are exact-time milestones; normal steps take at least one minute."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "FLEXIBLE",
            "HARD_ANCHOR"
          ]
        },
        "location": {
          "type": "string"
        },
        "dj": {
          "$ref": "#/$defs/djCue"
        },
        "teleprompter": {
          "$ref": "#/$defs/teleprompter"
        },
        "subTasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mcCues": {
          "type": "array",
          "description": "Localized MC lines for this step (language, timing, text).",
          "items": {
            "$ref": "#/$defs/mcCue"
          }
        },
        "mandatory": {
          "$ref": "#/$defs/mandatory"
        },
        "ceremony": {
          "$ref": "#/$defs/ceremony"
        },
        "game": {
          "$ref": "#/$defs/game"
        },
        "photographerCue": {
          "type": "string",
          "description": "Optional photographer/vendor cue for this step. Swap warns and defer skips protected steps."
        },
        "isMainSongRequired": {
          "type": "boolean",
          "default": false,
          "description": "Whether this step requires a main song (for example Grand Entrance, Wedding cake, First Dance). Missing values are treated as false."
        },
        "optionalFlag": {
          "type": "string",
          "enum": [
            "oczepiny",
            "dj_set"
          ],
          "description": "Predefined step shown only when the matching cartridge feature is enabled; `dj_set` marks a basic DJ set step. Wishes and games are represented by their own steps."
        },
        "grandEntranceOrder": {
          "type": "string",
          "enum": [
            "GUESTS_FIRST",
            "NEWLYWEDS_FIRST"
          ],
          "description": "Grand Entrance guest order from the Google Doc."
        },
        "firstDanceMode": {
          "type": "string",
          "enum": [
            "FAKE",
            "NORMAL"
          ],
          "description": "First Dance variant from the Google Doc."
        },
        "firstDanceStartAt": {
          "$ref": "https://weselnyzabojad.example/schemas/domains/first-dance.json#/items/properties/firstDanceStartAt"
        },
        "firstDanceStopAt": {
          "$ref": "https://weselnyzabojad.example/schemas/domains/first-dance.json#/items/properties/firstDanceStopAt"
        },
        "song": {
          "$ref": "https://weselnyzabojad.example/schemas/domains/first-dance.json#/items/properties/song"
        },
        "firstDanceNotes": {
          "type": "string"
        }
      }
    },
    "mcCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/language"
        },
        "timing": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mandatory": {
      "type": "object",
      "description": "Mandatory metadata owned by this timeline step. The step time is the only clock value.",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "FIRST_GUESTS_ARRIVAL",
            "KITCHEN_SERVICE",
            "CAKE_SERVICE",
            "CLOSURE",
            "MILESTONE"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "serviceMode": {
          "type": "string",
          "enum": [
            "TABLE_SERVICE",
            "BUFFET"
          ]
        },
        "cakeServiceMode": {
          "type": "string",
          "enum": [
            "KITCHEN_RETURN",
            "CUT_IN_PLACE"
          ]
        },
        "closureExtensionAllowed": {
          "type": "boolean"
        },
        "closureExtensionUntil": {
          "$ref": "#/$defs/clock"
        },
        "lastSong": {
          "type": "string"
        },
        "milestoneKind": {
          "type": "string",
          "enum": [
            "PHOTO",
            "CAMERA",
            "VENDOR",
            "SUNSET",
            "TRANSPORT",
            "FAMILY",
            "OTHER"
          ]
        },
        "alertBeforeMin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        }
      }
    },
    "ceremony": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ceremony variant and MC support requirements owned by the Ceremony step.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RELIGIOUS",
            "CIVIL",
            "HUMANIST"
          ]
        },
        "mcSupportRequested": {
          "type": "boolean"
        },
        "location": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "description": "One configured game and its question list, owned by the game timeline step.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "gameType": {
          "type": "string",
          "enum": [
            "TEST_WIEDZY",
            "TEST_ZGODNOSCI",
            "OTHER"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "requiresPhotographer": {
          "type": "boolean",
          "description": "The game needs a photographer on the floor (for example Speed Foto)."
        },
        "sourceDocId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNAVAILABLE"
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": [
                  "string",
                  "object"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "level": {
                "type": "string",
                "enum": [
                  "EASY",
                  "MEDIUM",
                  "HARD"
                ]
              },
              "answer": {
                "type": [
                  "string",
                  "object"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
