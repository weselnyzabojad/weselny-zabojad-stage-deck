{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/attractions.json",
  "title": "Attractions domain",
  "description": "Optional parallel attractions such as a photobooth, guest book or Polaroids. They never create timeline steps.",
  "type": "object",
  "properties": {
    "attractions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["PHOTO_BOOTH", "GUEST_BOOK", "POLAROIDS", "OTHER"],
            "description": "Normalized attraction type (aliases are mapped before validation)."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Time in HH:mm format"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Time in HH:mm format"
          },
          "location": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "startTime",
          "endTime",
          "location",
          "notes"
        ]
      }
    }
  },
  "required": [
    "attractions"
  ]
}
