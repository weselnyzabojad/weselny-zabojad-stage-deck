{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/cake.json",
  "title": "Cake protocol domain",
  "description": "Cake protocol mapped from the Google Doc; the cutting song stays in sync with musicPolicy.importantSongs[] (moment CAKE).",
  "type": "object",
  "properties": {
    "cake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "cuttingSong": {
          "type": "string",
          "minLength": 1
        },
        "sparklers": {
          "type": "boolean"
        },
        "photographerCue": {
          "type": "string"
        },
        "serveTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    }
  },
  "required": [
    "cake"
  ]
}
