{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/photo-plan.json",
  "title": "Photo plan domain",
  "description": "Sunset and photo-plan support mapped from the Google Doc (sunset source is ONLINE_API only).",
  "type": "object",
  "properties": {
    "photoPlan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sunset": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "source": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "latitude": {
              "type": "number"
            },
            "longitude": {
              "type": "number"
            },
            "timezone": {
              "type": "string"
            },
            "lastFetchedAt": {
              "type": "string",
              "format": "date-time"
            },
            "sunsetTime": {
              "type": "string",
              "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
              "description": "Time in HH:mm format"
            },
            "goldenHourStart": {
              "type": "string",
              "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
              "description": "Time in HH:mm format"
            },
            "civilTwilightEnd": {
              "type": "string",
              "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
              "description": "Time in HH:mm format"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "provider",
            "latitude",
            "longitude",
            "timezone",
            "status"
          ]
        }
      },
      "required": [
        "sunset"
      ]
    }
  },
  "required": [
    "photoPlan"
  ]
}
