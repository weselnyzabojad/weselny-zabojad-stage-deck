{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/demographics.json",
  "title": "Guest demographics domain",
  "description": "Guest counts and notes mapped from the Google Doc. Display-only in the app today.",
  "type": "object",
  "properties": {
    "demographics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pl": {
          "type": "integer",
          "minimum": 0
        },
        "fr": {
          "type": "integer",
          "minimum": 0
        },
        "other": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "demographics"
  ]
}
