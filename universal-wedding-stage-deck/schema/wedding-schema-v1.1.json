    "songSource": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Where a key song comes from. Customer files keep a stable fileRef (never audio bytes); streaming sources keep the exact customer URL. shortUrl is an optional pre-approved stable redirect for the QR.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "CUSTOMER_FILE",
            "YOUTUBE",
            "SPOTIFY",
            "DEEZER",
            "OTHER"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "Exact customer link for streaming sources, or a stable shared HTTPS URL for a customer file. Never a signed URL."
        },
        "shortUrl": {
          "type": "string",
          "pattern": "^https?://",
          "description": "Optional pre-approved stable redirect used only for the QR so it survives link edits."
        },
        "fileRef": {
          "type": "string",
          "minLength": 1,
          "description": "Stable asset reference for CUSTOMER_FILE. Required for customer files."
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string"
        },
        "durationSec": {
          "type": "integer",
          "minimum": 0
        },
        "availability": {
          "type": "string",
          "enum": [
            "LOCAL",
            "MISSING"
          ]
        },
        "label": {
          "type": "string",
          "description": "Display label for OTHER sources (Tidal, Apple Music, SoundCloud, ...)."
        },
        "notes": {
          "type": "string"
        }
      }
    },
