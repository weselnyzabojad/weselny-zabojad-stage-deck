{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/steps.json",
  "title": "Timeline steps domain",
  "description": "Plan-of-the-day timeline mapped from the Google Doc. Each step is a FLEXIBLE or HARD_ANCHOR block.",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "required": [
    "steps"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "clock": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "24-hour local clock time as HH:MM."
    },
    "language": {
      "type": "string",
      "enum": [
        "PL",
        "FR",
        "EN"
      ]
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "PL": {
          "type": "string"
        },
        "FR": {
          "type": "string"
        },
        "EN": {
          "type": "string"
        }
      }
    },
    "djCue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "playlist": {
          "type": "string"
        },
        "track": {
          "type": "string"
        },
        "cutoff": {
          "$ref": "#/$defs/clock"
        },
        "cutoffSec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "note": {
          "type": "string"
        }
      }
    },
    "speechItem": {
      "type": "object",
      "required": [
        "id",
        "heading",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "heading": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "lang",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "lang": {
                "$ref": "#/$defs/language"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "gameQuestion": {
      "type": "object",
      "required": [
        "id",
        "question",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "$ref": "#/$defs/localizedText"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "teleprompter": {
      "type": "object",
      "required": [
        "has_script",
        "type",
        "title",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "has_script": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "SPEECH",
            "GAME_QUESTIONS"
          ]
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "SPEECH"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/speechItem"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "GAME_QUESTIONS"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/gameQuestion"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "items": {
                "minItems": 1
              }
            },
            "required": [
              "items"
            ]
          },
          "then": {
            "properties": {
              "has_script": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "time",
        "durationMin",
        "title",
        "type",
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "time": {
          "$ref": "#/$defs/clock",
          "description": "Planned start time."
        },
        "planned": {
          "$ref": "#/$defs/clock",
          "description": "Optional explicit planned start; overrides time for drift math."
        },
        "realStart": {
          "$ref": "#/$defs/clock",
          "description": "Optional seeded actual start, mainly for demos/tests."
        },
        "durationMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "FLEXIBLE",
            "HARD_ANCHOR"
          ]
        },
        "location": {
          "type": "string"
        },
        "dj": {
          "$ref": "#/$defs/djCue"
        },
        "teleprompter": {
          "$ref": "#/$defs/teleprompter"
        },
        "subTasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mcCues": {
          "type": "array",
          "description": "Localized MC lines for this step (language, timing, text).",
          "items": {
            "$ref": "#/$defs/mcCue"
          }
        },
        "photographerCue": {
          "type": "string",
          "description": "Optional photographer/vendor cue for this step. Swap warns and defer skips protected steps."
        },
        "isMainSongRequired": {
          "type": "boolean",
          "default": false,
          "description": "Whether this step requires a main song (for example Grand Entrance, Wedding cake, First Dance). Missing values are treated as false."
        },
        "optionalFlag": {
          "type": "string",
          "enum": [
            "wishes",
            "games",
            "oczepiny"
          ],
          "description": "Predefined step is shown only when the matching cartridge feature is enabled."
        },
        "gameId": {
          "$ref": "#/$defs/id",
          "description": "Game question-list id when optionalFlag is games."
        },
        "ceremonyType": {
          "type": "string",
          "enum": [
            "CHURCH",
            "VENUE",
            "NONE"
          ]
        },
        "ceremonyLocation": {
          "type": "string"
        },
        "grandEntranceOrder": {
          "type": "string",
          "enum": [
            "GUESTS_FIRST",
            "NEWLYWEDS_FIRST"
          ],
          "description": "Grand Entrance guest order from the Google Doc."
        },
        "firstDanceMode": {
          "type": "string",
          "enum": [
            "FAKE",
            "NORMAL"
          ],
          "description": "First Dance variant from the Google Doc."
        },
        "firstDanceStartAt": {
          "$ref": "https://weselnyzabojad.example/schemas/domains/first-dance.json#/items/properties/firstDanceStartAt"
        },
        "firstDanceStopAt": {
          "$ref": "https://weselnyzabojad.example/schemas/domains/first-dance.json#/items/properties/firstDanceStopAt"
        },
        "song": {
          "$ref": "https://weselnyzabojad.example/schemas/domains/first-dance.json#/items/properties/song"
        },
        "firstDanceNotes": {
          "type": "string"
        }
      }
    },
    "mcCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/language"
        },
        "timing": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
