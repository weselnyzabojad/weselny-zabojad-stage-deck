{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/first-dance.json",
  "title": "First dance domain",
  "description": "First-dance step objects mapped from the Google Doc (mm:ss timestamps + song).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "time": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "location": {
        "type": "string"
      },
      "isMainSongRequired": {
        "type": "boolean"
      },
      "firstDanceMode": {
        "type": "string"
      },
      "firstDanceStartAt": {
        "type": "string",
        "pattern": "^[0-5][0-9]:[0-5][0-9]$",
        "description": "Timestamp in mm:ss format"
      },
      "firstDanceStopAt": {
        "type": "string",
        "pattern": "^[0-5][0-9]:[0-5][0-9]$",
        "description": "Timestamp in mm:ss format"
      },
      "firstDanceNotes": {
        "type": "string"
      },
      "song": {
        "type": "object",
        "properties": {
          "artist": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "Note": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "artist",
          "title",
          "Note",
          "source"
        ]
      }
    },
    "required": [
      "id",
      "time",
      "title",
      "type",
      "location",
      "isMainSongRequired",
      "firstDanceMode",
      "firstDanceStartAt",
      "firstDanceStopAt",
      "firstDanceNotes",
      "song"
    ]
  }
}
