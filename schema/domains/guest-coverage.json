{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/guest-coverage.json",
  "title": "Guest coverage domain",
  "description": "Photo guest-coverage plan mapped from the Google Doc.",
  "type": "object",
  "properties": {
    "guestCoverage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allGuests": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "description": "Small groups the newlyweds want photos with.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "guestCoverage"
  ]
}
