{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/special-effects.json",
  "title": "Special effects domain",
  "description": "Photo-plan special effects (sparklers, fire, smoke) mapped from the Google Doc.",
  "type": "object",
  "properties": {
    "specialEffects": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sparklers": {
          "type": "boolean"
        },
        "fire": {
          "type": "boolean"
        },
        "heavySmoke": {
          "type": "boolean"
        },
        "other": {
          "type": "string"
        },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-effect approvals supplied by the Venue Manager.",
          "properties": {
            "sparklers": {
              "type": "boolean"
            },
            "fire": {
              "type": "boolean"
            },
            "heavySmoke": {
              "type": "boolean"
            },
            "other": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "required": [
    "specialEffects"
  ]
}
