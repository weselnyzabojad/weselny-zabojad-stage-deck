{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weselnyzabojad.example/schemas/domains/oczepiny.json",
  "title": "Oczepiny domain",
  "description": "Oczepini / midnight tradition cues mapped from the Google Doc.",
  "type": "object",
  "properties": {
    "oczepiny": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "order": {
          "type": "string",
          "enum": [
            "MIDNIGHT",
            "EARLY"
          ]
        },
        "anchorId": {
          "type": "string"
        },
        "toss": {
          "type": "string",
          "enum": [
            "VEIL",
            "BOUQUET"
          ]
        },
        "ties": {
          "type": "string",
          "enum": [
            "BOW_TIE",
            "CRAVAT"
          ]
        },
        "winnerPhoto": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "photographerCue": {
              "type": "string"
            },
            "winnersOnly": {
              "type": "boolean"
            },
            "winnersWithCouple": {
              "type": "boolean"
            },
            "photographerAvailable": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "photographerCue",
            "winnersOnly",
            "winnersWithCouple",
            "photographerAvailable"
          ]
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "songs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "decidedByDj": {
              "type": "boolean"
            }
          },
          "required": [
            "songs",
            "decidedByDj"
          ]
        },
        "subEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "enum": [
                  "Veil toss",
                  "Bouquet toss",
                  "Bow-tie game",
                  "Cravat toss",
                  "Winner photo",
                  "Winners with couple photo"
                ],
                "description": "Only the four throwings and the two winner-photo moments are allowed."
              }
            },
            "required": [
              "id",
              "title"
            ]
          }
        },
        "game": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "countdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "SONGS",
                "MC_MIC_COUNTDOWN"
              ]
            }
          }
        },
        "testZgodnosci": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "enabled",
        "order",
        "toss",
        "ties",
        "winnerPhoto",
        "music",
        "subEvents"
      ]
    }
  },
  "required": [
    "oczepiny"
  ]
}
