# Local Edge Function environment for `supabase functions serve`.
# Copy to supabase/.env.local (gitignored) and fill values from `npx supabase status`.
# Never put production values or real secrets in this file.

ALLOWED_ORIGIN=http://localhost:5173
PUBLIC_DECK_URL=http://localhost:5173

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status

# Generate a local ES256 key pair; never reuse the production key.
DECK_SUPABASE_JWT_PRIVATE_KEY=local-private-key
DECK_SUPABASE_JWT_KEY_ID=local-key-id

# Any 32-byte random local value.
SPEECH_SECRET_MASTER_KEY=local-32-byte-random-value

# Optional Google Drive test credentials.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_TEST_FILE_ID=
