# Local Edge Function environment for `supabase functions serve`.
# Copy to supabase/.env.local (gitignored) and fill values from `npx supabase status`.
# Never put production values or real secrets in this file.

ALLOWED_ORIGIN=http://localhost:5173
PUBLIC_DECK_URL=http://localhost:5173

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status

# Generate a local ES256 key pair; never reuse the production key.
DECK_SUPABASE_JWT_PRIVATE_KEY=local-private-key
DECK_SUPABASE_JWT_KEY_ID=local-key-id

# Any 32-byte random local value.
SPEECH_SECRET_MASTER_KEY=local-32-byte-random-value

# Google Drive: `local:start` generates a disposable service account and points
# these at the dockerized mock. Set GOOGLE_DRIVE_API_BASE= to call real Google.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_API_BASE=
GOOGLE_DRIVE_TEST_FILE_ID=

# Service health probes (issue #979). Local values point at tools/service-mock;
# production uses the real Sentry project and sunrise-sunset.org endpoint.
SENTRY_API_BASE=http://service-mock:8080/sentry/api/0
SENTRY_ORG_SLUG=local
SENTRY_PROJECT_SLUG=stage-deck
SENTRY_API_TOKEN=local-service-mock-token
SUNSET_HEALTH_URL=http://service-mock:8080/sunset
GOOGLE_DRIVE_HEALTH_FILE_ID=1Q7IVT0GNiLztKQE8l4eCDCRw-px1qheh
# Netlify site health (issue #1029). The token is a read-only personal access
# token; never commit real values.
NETLIFY_API_BASE=http://service-mock:8080/netlify/api/v1
NETLIFY_SITE_ID=stage-deck
NETLIFY_API_TOKEN=local-service-mock-token
# Production deck probe (issue #1028); falls back to the production URL.
PUBLIC_DECK_URL=http://service-mock:8080/deck
